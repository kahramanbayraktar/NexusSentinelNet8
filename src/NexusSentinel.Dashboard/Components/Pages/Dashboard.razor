@page "/"
@using NexusSentinel.Dashboard.Services
@using NexusSentinel.Dashboard.Components
@using NexusSentinel.Shared.Protos
@inject DeviceStateService SystemState
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Dashboard | Nexus</PageTitle>

<div class="container-fluid py-4">
    <!-- Minimal Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="mb-1 fw-bold tracking-tight">System Status</h2>
            <div class="d-flex align-items-center text-secondary">
                <span class="status-indicator status-normal me-2"></span>
                <span style="font-size: 0.9rem;">Live Telemetry Stream</span>
            </div>
        </div>

        <div class="d-flex align-items-center">
            @if (IsLoading)
            {
                <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                <span class="text-secondary small">Syncing...</span>
            }
            else
            {
                <span class="minimal-badge">
                    <i class="bi bi-arrow-repeat me-1"></i> @DateTime.Now.ToString("HH:mm:ss")
                </span>
            }
        </div>
    </div>

    <!-- Error State -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center border-0 shadow-sm" role="alert"
            style="background-color: rgba(239, 68, 68, 0.1); color: #f87171;">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            <div>@ErrorMessage</div>
        </div>
    }

    <!-- Device Grid -->
    <div class="row">
        @foreach (var device in Devices.OrderBy(d => d.DeviceId))
        {
            <DeviceCard Record="device" />
        }
    </div>

    <!-- Empty State -->
    @if (Devices.Count == 0 && !IsLoading && string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="text-center py-5">
            <div class="mb-3 text-secondary" style="opacity: 0.5;">
                <i class="bi bi-hdd-network" style="font-size: 3rem;"></i>
            </div>
            <h5 class="fw-normal text-secondary">No active signals detected.</h5>
            <p class="small text-muted">Ensure the Simulator and Ingestion services are running.</p>
        </div>
    }
</div>

@code {
    private List<TelemetryRecord> Devices = new();
    private PeriodicTimer? _timer;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        // Sayfa açılır açılmaz timer başlat
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        // Arka planda sürekli çalışacak döngüyü başlat (Fire-and-forget)
        _ = RunTimerLoop();
    }

    private async Task RunTimerLoop()
    {
        // İlk açılışta veriyi hemen çek
        await RefreshData();

        try
        {
            // Timer tikledikçe çalış
            while (await _timer!.WaitForNextTickAsync())
            {
                await RefreshData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Timer Loop Error: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        Console.WriteLine($"[Dashboard] Refreshing data at {DateTime.Now:HH:mm:ss}");
        try
        {
            // First load: show spinner
            if (Devices.Count == 0) IsLoading = true;
            ErrorMessage = null;

            // Timeout after 2 seconds
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));

            // Wait for data or timeout
            Devices = await SystemState.GetLatestStatesAsync().WaitAsync(cts.Token);
        }
        catch (TimeoutException)
        {
            ErrorMessage = "Redis connection timed out (2s).";
            Console.WriteLine("RefreshData timed out.");
        }
        catch (TaskCanceledException)
        {
            ErrorMessage = "Redis connection timed out (2s).";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Data Fetch Error: {ex.Message}";
            Console.WriteLine($"Error fetching data: {ex}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}